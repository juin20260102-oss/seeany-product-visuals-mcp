{
  "name": "seeany-sun-mcp",
  "version": "0.4.2",
  "private": false,
  "description": "Generate ecommerce product images from coding agents with SeeAny: upload references, refine prompts, quote, create tasks, track status, and download results.",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "skills",
    ".codex-plugin",
    ".mcp.json",
    ".agents",
    "README.md",
    ".env.example",
    "LICENSE"
  ],
  "bin": {
    "seeany-sun-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "live-smoke": "npm run build && node scripts/live-smoke.mjs",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "validate:plugin": "node scripts/validate-plugin.mjs",
    "verify": "npm run validate:plugin && npm run smoke && npm run pack:check",
    "pack:check": "npm run build && npm pack --dry-run",
    "prepublishOnly": "npm run validate:plugin && npm run build && npm run smoke"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/juin20260102-oss/seeany-sun-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/juin20260102-oss/seeany-sun-mcp/issues"
  },
  "homepage": "https://github.com/juin20260102-oss/seeany-sun-mcp#readme",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.3"
  }
}
