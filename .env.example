# Set this to use the real SeeAny API. Never commit the actual key.
SEEANY_API_KEY=sk-sa-xxxxxxxx

# Optional overrides.
SEEANY_API_BASE_URL=https://api.seeany.com
SEEANY_USER_AGENT=seeany-product-visuals-mcp
SEEANY_DEMO_BASE_URL=https://seeany-nuxt.pages.dev

# Set demo to force offline fixtures even when SEEANY_API_KEY is present.
SEEANY_MCP_MODE=demo
